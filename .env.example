# Copy to .env in repository root. DO NOT COMMIT .env.
WEB_PORT=3000
MYSQL_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_PASSWORD
# URL EXACTE de la racine PHP du magasin, sans /index.php.
# URL en HTTP pour les tests locaux. Pour Netikash ou Shwary, utiliser une URL publique HTTPS.
APP_URL=http://localhost:3000

# Disabled until merchant OAuth2 credentials and HTTPS webhook are configured.
NETIKASH_ENABLED=0
NETIKASH_CLIENT_ID=
NETIKASH_CLIENT_SECRET=
NETIKASH_WEBHOOK_SECRET=
# Selon /documentation (raw body + Base64), ou /examples (timestamp.body + hex).
# Confirmer le format qui correspond à la configuration du compte marchand.
NETIKASH_WEBHOOK_SIGNATURE_MODE=raw_base64

# Mobile Money Shwary RDC. Renseigner le taux marchand entier CDF pour 1 USD.
SHWARY_ENABLED=0
SHWARY_SANDBOX=1
SHWARY_MERCHANT_ID=
SHWARY_MERCHANT_KEY=
SHWARY_CDF_PER_USD=
