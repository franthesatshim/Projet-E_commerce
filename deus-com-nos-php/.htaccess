Options -Indexes
<FilesMatch "(?i)\.(sql|md|bak|log|env|ini|ya?ml|sh)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^payments/ - [F,L]
RewriteRule ^tests/ - [F,L]
RewriteRule ^assets/products/uploads/.*\.(php[0-9]?|phtml|phar)$ - [F,L,NC]
